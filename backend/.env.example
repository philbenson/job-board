# Copy to .env: the service reads its settings from here or from the environment,
# and refuses to start, naming the setting, while any of them is missing or malformed.
# The tests read DATABASE_URL, else this line, never .env. It matches the database in compose.yaml.
DATABASE_URL=postgresql://job_board:job_board@127.0.0.1:55432/job_board

# Sign-in, from a Clerk application (a development instance is free), on the API keys
# page of its dashboard.
# The Frontend API URL, for instance https://your-app.clerk.accounts.dev
CLERK_ISSUER=
# Show JWT public key, then the PEM Public Key. Keep it in double quotes, on its lines
# as copied or on one line with \n between them.
CLERK_JWT_KEY=
# The origins of the pages allowed to send session tokens, comma-separated: the web app's
# dev server locally, its real address once deployed.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
