{
  "openapi": "3.1.0",
  "info": {
    "title": "Job board",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "summary": "Me",
        "operationId": "me_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "No valid session token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refused"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/model-key": {
      "get": {
        "summary": "Read Model Key",
        "operationId": "read_model_key_model_key_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedModelKey"
                }
              }
            }
          },
          "401": {
            "description": "No valid session token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refused"
                }
              }
            }
          },
          "404": {
            "description": "No key saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refused"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "put": {
        "summary": "Save Model Key",
        "operationId": "save_model_key_model_key_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModelKeyToSave"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedModelKey"
                }
              }
            }
          },
          "401": {
            "description": "No valid session token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refused"
                }
              }
            }
          },
          "422": {
            "description": "A malformed key, or one Anthropic refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelKeyRefused"
                }
              }
            }
          },
          "429": {
            "description": "Too many checks of this person's keys",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelKeyRefused"
                }
              }
            }
          },
          "503": {
            "description": "Anthropic did not confirm the key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelKeyRefused"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "delete": {
        "summary": "Remove Model Key",
        "operationId": "remove_model_key_model_key_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "No valid session token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refused"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/profile": {
      "get": {
        "summary": "Read Profile",
        "description": "The signed-in person's profile; an empty one, written nowhere, before their first save.",
        "operationId": "read_profile_profile_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "401": {
            "description": "No valid session token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refused"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/profile/target-titles": {
      "put": {
        "summary": "Save Target Titles",
        "description": "Replaces the signed-in person's target titles and answers the profile as stored.",
        "operationId": "save_target_titles_profile_target_titles_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TargetTitles"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "401": {
            "description": "No valid session token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refused"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status"
          },
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "unreachable"
            ],
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "title": "Health"
      },
      "Me": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "Me"
      },
      "ModelKeyRefused": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "reason": {
            "type": "string",
            "enum": [
              "malformed",
              "rejected",
              "not-permitted",
              "unavailable",
              "check-running",
              "too-many-checks"
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "detail",
          "reason"
        ],
        "title": "ModelKeyRefused"
      },
      "ModelKeyToSave": {
        "properties": {
          "provider": {
            "type": "string",
            "const": "anthropic",
            "title": "Provider"
          },
          "key": {
            "type": "string",
            "format": "password",
            "title": "Key",
            "writeOnly": true
          }
        },
        "type": "object",
        "required": [
          "provider",
          "key"
        ],
        "title": "ModelKeyToSave"
      },
      "Profile": {
        "properties": {
          "target_titles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Target Titles"
          }
        },
        "type": "object",
        "required": [
          "target_titles"
        ],
        "title": "Profile",
        "description": "The whole profile, as stored and as answered."
      },
      "Refused": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "Refused"
      },
      "SavedModelKey": {
        "properties": {
          "provider": {
            "type": "string",
            "const": "anthropic",
            "title": "Provider"
          },
          "last_four": {
            "type": "string",
            "title": "Last Four"
          },
          "checked_at": {
            "type": "string",
            "format": "date-time",
            "title": "Checked At"
          },
          "usable": {
            "type": "boolean",
            "title": "Usable"
          },
          "failure": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "rejected",
                  "not-permitted",
                  "no-credit"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure"
          },
          "failed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failed At"
          }
        },
        "type": "object",
        "required": [
          "provider",
          "last_four",
          "checked_at",
          "usable",
          "failure",
          "failed_at"
        ],
        "title": "SavedModelKey"
      },
      "TargetTitles": {
        "properties": {
          "titles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Titles"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "titles"
        ],
        "title": "TargetTitles",
        "description": "The body that replaces the target titles. An empty list means none chosen."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "A Clerk session token.",
        "scheme": "bearer"
      }
    }
  }
}
