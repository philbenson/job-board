  "components": {
    "schemas": {
      "DealBreakers": {
        "properties": {
          "industries": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 300,
            "title": "Industries",
            "description": "Industries they will not work in, each up to 100 characters; at most 30."
          },
          "company_sizes": {
            "items": {
              "type": "string",
              "enum": [
                "1-10",
                "11-50",
                "51-200",
                "201-500",
                "501-1000",
                "1001-5000",
                "5001-10000",
                "10001+"
              ]
            },
            "type": "array",
            "maxItems": 80,
            "title": "Company Sizes",
            "description": "Company sizes, by number of employees, they will not work at."
          },
          "no_agencies": {
            "type": "boolean",
            "title": "No Agencies",
            "description": "Whether a posting from a recruiting agency, not the employer, rules it out."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "industries",
          "company_sizes",
          "no_agencies"
        ],
        "title": "DealBreakers",
        "description": "What rules a posting out for a person whatever else it offers."
      },
      "Gaps": {
        "properties": {
          "apply_with": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Apply With",
            "description": "Requirements they lack but would still apply without, in their words, each up to 200 characters; at most 20."
          },
          "trade_offs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Trade Offs",
            "description": "What they would give up for the right role, in their words, each up to 200 characters; at most 20."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "apply_with",
          "trade_offs"
        ],
        "title": "Gaps",
        "description": "Where a person falls short of a posting and still applies, and what they would give up."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status"
          },
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "unreachable"
            ],
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "title": "Health"
      },
      "Me": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "Me"
      },
      "ModelKeyRefused": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "reason": {
            "type": "string",
            "enum": [
              "malformed",
              "rejected",
              "not-permitted",
              "unavailable",
              "check-running",
              "too-many-checks"
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "detail",
          "reason"
        ],
        "title": "ModelKeyRefused"
      },
      "ModelKeyToSave": {
        "properties": {
          "provider": {
            "type": "string",
            "const": "anthropic",
            "title": "Provider"
          },
          "key": {
            "type": "string",
            "format": "password",
            "title": "Key",
            "writeOnly": true
          }
        },
        "type": "object",
        "required": [
          "provider",
          "key"
        ],
        "title": "ModelKeyToSave"
      },
      "Office": {
        "properties": {
          "city": {
            "type": "string",
            "title": "City",
            "description": "The city's name as the person typed it, up to 100 characters."
          },
          "days_a_week": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Days A Week",
            "description": "Days a week in the office, from 1 to 5; 5 means on site."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "city",
          "days_a_week"
        ],
        "title": "Office",
        "description": "A city a person would go into an office in, and how often."
      },
      "Pay": {
        "properties": {
          "floor_usd": {
            "type": "integer",
            "maximum": 10000000.0,
            "minimum": 0.0,
            "title": "Floor Usd",
            "description": "The lowest annual base pay, in whole US dollars, they would take."
          },
          "ask_usd": {
            "type": "integer",
            "maximum": 10000000.0,
            "minimum": 0.0,
            "title": "Ask Usd",
            "description": "The annual base pay, in whole US dollars, they ask for; at least the floor."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "floor_usd",
          "ask_usd"
        ],
        "title": "Pay",
        "description": "What a person will be paid: annual base pay in whole US dollars, before bonus or equity."
      },
      "Places": {
        "properties": {
          "remote_ok": {
            "type": "boolean",
            "title": "Remote Ok",
            "description": "Whether a fully remote role is fine."
          },
          "offices": {
            "items": {
              "$ref": "#/components/schemas/Office"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Offices",
            "description": "Cities, as typed, where they would go into an office, and how many days a week; at most 20, one per city."
          },
          "states": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 510,
            "title": "States",
            "description": "US states they would work in, as two-letter postal codes, DC included; any case is taken and stored in upper case."
          },
          "will_relocate": {
            "type": "boolean",
            "title": "Will Relocate",
            "description": "Whether they would move for a role."
          },
          "relocate_for": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Relocate For",
            "description": "Companies they would move for even though they would not move otherwise, each up to 100 characters; at most 20, and empty when they would move anyway."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "remote_ok",
          "offices",
          "states",
          "will_relocate",
          "relocate_for"
        ],
        "title": "Places",
        "description": "Where a person will work: remote, offices in named cities, US states, and moving."
      },
      "Profile": {
        "properties": {
          "target_titles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Target Titles"
          },
          "title_range": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TitleRange"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null until the person saves this section."
          },
          "places": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Places"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null until the person saves this section."
          },
          "pay": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Pay"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null until the person saves this section."
          },
          "skills": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Skills"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null until the person saves this section."
          },
          "gaps": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Gaps"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null until the person saves this section."
          },
          "deal_breakers": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DealBreakers"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null until the person saves this section."
          }
        },
        "type": "object",
        "required": [
          "target_titles",
          "title_range",
          "places",
          "pay",
          "skills",
          "gaps",
          "deal_breakers"
        ],
        "title": "Profile",
        "description": "The whole profile, as stored and as answered."
      },
      "Refused": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "Refused"
      },
      "SavedModelKey": {
        "properties": {
          "provider": {
            "type": "string",
            "const": "anthropic",
            "title": "Provider"
          },
          "last_four": {
            "type": "string",
            "title": "Last Four"
          },
          "checked_at": {
            "type": "string",
            "format": "date-time",
            "title": "Checked At"
          },
          "usable": {
            "type": "boolean",
            "title": "Usable"
          }
        },
        "type": "object",
        "required": [
          "provider",
          "last_four",
          "checked_at",
          "usable"
        ],
        "title": "SavedModelKey"
      },
      "Skill": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "The skill, as the person names it, up to 60 characters."
          },
          "years": {
            "type": "integer",
            "maximum": 60.0,
            "minimum": 0.0,
            "title": "Years",
